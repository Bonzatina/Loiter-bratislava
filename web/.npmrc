# Pin the public registry for this project.
#
# A machine whose global npm registry is a private proxy would otherwise write
# that host into every `resolved` URL of package-lock.json, and a build host
# that cannot reach it fails `npm ci` with the opaque "Exit handler never called!".
# Keeping the registry here means the committed lockfile always carries portable
# https://registry.npmjs.org/ URLs, whoever installs and wherever.
registry=https://registry.npmjs.org/

engine-strict=false
